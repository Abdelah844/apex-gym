rules_version = '2';

// =====================================================
// APEX GYM 2.1.1 · REGLAS DE SEGURIDAD DEL SERVIDOR (Firebase Firestore)
// Estado: ESCRITAS, NO EJECUTADAS. Hay que pasar servidor/reglas.test.js con el
// emulador de Firebase antes de conectar usuarios reales.
//
// Principios:
//  1. Todo se identifica por request.auth.uid (id permanente), nunca por el nombre de usuario.
//  2. Lo que decide permisos y no debe falsearse (rango, edad verificada) lo escribe SOLO el servidor
//     con Cloud Functions (Admin SDK, que no pasa por estas reglas). El cliente no puede tocarlo.
//  3. Las reglas reproducen la política de publicación de la app: perfil no privado,
//     "compartir entrenos" activado y mayoría de edad verificada.
// =====================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de ayuda ----------
    function conectado() { return request.auth != null; }
    function soyYo(uid) { return conectado() && request.auth.uid == uid; }
    function esModerador() { return conectado() && request.auth.token.moderador == true; }
    function perfil(uid) { return get(/databases/$(database)/documents/perfiles/$(uid)).data; }
    function verificado(uid) { return get(/databases/$(database)/documents/verificaciones/$(uid)).data; }
    function meHaBloqueado(uid) {
      return exists(/databases/$(database)/documents/usuarios/$(uid)/bloqueados/$(request.auth.uid));
    }
    function leHeBloqueado(uid) {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)/bloqueados/$(uid));
    }
    // Política de bloqueo: si cualquiera de los dos bloquea al otro, no se ven en ningún sitio
    function hayBloqueo(uid) { return meHaBloqueado(uid) || leHeBloqueado(uid); }
    function somosAmigos(uid) { return request.auth.uid in perfil(uid).amigos; }

    // ¿Puedo ver el contenido de este autor? (misma regla para publicaciones y sus comentarios)
    function puedoVerA(autor) {
      return conectado() && (autor == request.auth.uid || (
        !hayBloqueo(autor) && (
          perfil(autor).visibilidad == "publico" ||
          (perfil(autor).visibilidad == "amigos" && somosAmigos(autor)))));
    }

    // Política de publicación (la misma que puedePublicar() en logica.js)
    function puedePublicar() {
      return conectado()
        && perfil(request.auth.uid).visibilidad != "privado"
        && perfil(request.auth.uid).compartirEntrenos == true
        && verificado(request.auth.uid).mayor16 == true;
    }

    // ---------- Datos privados: solo su dueño ----------
    // Perfil completo, ajustes, sesiones, rutinas, retos personales y bloqueos
    match /usuarios/{uid} {
      allow read, write: if soyYo(uid);
      match /{coleccion}/{doc} {
        allow read, write: if soyYo(uid);
      }
    }

    // ---------- Verificaciones: SOLO el servidor escribe ----------
    // Ej.: { mayor16: true, metodo: "...", fecha: ... } lo crea una Cloud Function tras verificar la edad.
    // La edad que el usuario escribe en su perfil NO se usa para dar permisos.
    match /verificaciones/{uid} {
      allow read: if soyYo(uid);
      allow write: if false;
    }

    // ---------- Perfil visible para otros ----------
    // El usuario puede cambiar su nombre visible, su visibilidad, su lista de amigos y si comparte entrenos.
    // El RANGO lo calcula y escribe solo el servidor a partir de las sesiones guardadas.
    match /perfiles/{uid} {
      allow read: if soyYo(uid) || (conectado() && !hayBloqueo(uid) && (
                     resource.data.visibilidad == "publico" ||
                     (resource.data.visibilidad == "amigos" && somosAmigos(uid))));

      allow create: if soyYo(uid)
        && request.resource.data.keys().hasOnly(["usuario", "visibilidad", "amigos", "compartirEntrenos"])
        && request.resource.data.usuario is string && request.resource.data.usuario.matches("^[a-z0-9._]{3,24}$")
        && request.resource.data.visibilidad in ["publico", "amigos", "privado"]
        && request.resource.data.compartirEntrenos is bool
        && request.resource.data.amigos is list;

      // Lista CERRADA: el usuario solo puede cambiar estos cuatro campos. Cualquier otro (rango, puntos,
      // campos nuevos inventados…) queda fuera.
      allow update: if soyYo(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usuario", "visibilidad", "amigos", "compartirEntrenos"])
        && request.resource.data.usuario is string && request.resource.data.usuario.matches("^[a-z0-9._]{3,24}$")
        && request.resource.data.visibilidad in ["publico", "amigos", "privado"]
        && request.resource.data.compartirEntrenos is bool
        && request.resource.data.amigos is list && request.resource.data.amigos.size() <= 500;

      allow delete: if soyYo(uid);
    }

    // ---------- Publicaciones ----------
    match /posts/{id} {
      allow read: if puedoVerA(resource.data.autorId);

      allow create: if puedePublicar()
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.keys().hasOnly(["autorId", "tipo", "texto", "fecha"])
        && request.resource.data.tipo in ["entreno", "record", "rango"]
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 300
        && request.resource.data.fecha == request.time;

      allow delete: if conectado() && (resource.data.autorId == request.auth.uid || esModerador());
      allow update: if false;

      // Los comentarios HEREDAN el permiso de lectura de la publicación
      match /comentarios/{c} {
        allow read: if puedoVerA(get(/databases/$(database)/documents/posts/$(id)).data.autorId);
        allow create: if conectado()
          && puedoVerA(get(/databases/$(database)/documents/posts/$(id)).data.autorId)
          && verificado(request.auth.uid).mayor16 == true
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.keys().hasOnly(["autorId", "texto", "fecha"])
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 200
          && request.resource.data.fecha == request.time;
        allow delete: if conectado() && (resource.data.autorId == request.auth.uid || esModerador());
        allow update: if false;
      }

      // "Me gusta": un documento por usuario, con id = su uid (no se puede votar dos veces ni por otro)
      match /likes/{uid} {
        allow read: if puedoVerA(get(/databases/$(database)/documents/posts/$(id)).data.autorId);
        allow create, delete: if soyYo(uid) && puedoVerA(get(/databases/$(database)/documents/posts/$(id)).data.autorId);
        allow update: if false;
      }
    }

    // ---------- Denuncias y moderación ----------
    // Cualquiera conectado puede denunciar, con un motivo válido. Solo los moderadores
    // (usuarios con la marca "moderador" puesta por el servidor) las leen y cambian su estado.
    match /denuncias/{id} {
      // La publicación denunciada tiene que existir y el autor indicado tiene que ser su autor real.
      // No se puede denunciar una publicación propia.
      allow create: if conectado()
        && request.resource.data.denuncianteId == request.auth.uid
        && request.resource.data.keys().hasOnly(["postId", "autorId", "denuncianteId", "motivo", "detalle", "fecha", "estado"])
        && request.resource.data.postId is string
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.autorId == request.resource.data.autorId
        && request.resource.data.autorId != request.auth.uid
        && request.resource.data.motivo in ["spam", "ofensivo", "falso", "otro"]
        && request.resource.data.detalle is string && request.resource.data.detalle.size() <= 300
        && request.resource.data.estado == "pendiente"
        && request.resource.data.fecha == request.time;
      allow read: if esModerador();
      allow update: if esModerador()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado", "resolucion", "moderadorId", "fechaResolucion"])
        && request.resource.data.estado in ["pendiente", "revisando", "aceptada", "rechazada"]
        && request.resource.data.moderadorId == request.auth.uid;
      allow delete: if false;
    }
  }
}

// =====================================================
// LO QUE ESTAS REGLAS NO PUEDEN HACER SOLAS (va en Cloud Functions):
//  - Calcular el rango a partir de las sesiones y escribirlo en perfiles/{uid}.
//  - Verificar la edad y escribir verificaciones/{uid}.
//  - Limitar publicaciones y comentarios por día (las reglas no cuentan documentos).
//  - Calcular resultados de retos entre amigos a partir de sesiones registradas.
//  - Avisar a moderadores de denuncias nuevas.
// =====================================================
